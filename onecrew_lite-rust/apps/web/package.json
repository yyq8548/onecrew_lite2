{
  "name": "onecrew-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mcp-apps": "npm --prefix ../mcp-ui run check && npm --prefix ../mcp-ui run build",
    "contracts:check": "node ../../development/schema-codegen/generate.mjs --config creator-sync-contracts.config.json --mode check && node ../../development/schema-codegen/generate.mjs --config discovery-contracts.config.json --mode check",
    "contracts:generate": "node ../../development/schema-codegen/generate.mjs --config creator-sync-contracts.config.json --mode generate && node ../../development/schema-codegen/generate.mjs --config discovery-contracts.config.json --mode generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:check": "node ../../development/scripts/sync-release-version.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "ds-store": "0.1.6"
  }
}
