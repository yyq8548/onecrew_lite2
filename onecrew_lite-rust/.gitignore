# ---- Rust / Cargo ----
/target
# 注:Cargo.lock 不忽略——这是应用,需锁定依赖版本

# ---- Node / 前端 (Vite + React) ----
node_modules/
apps/web/dist/

# ---- 第三方 vendored 依赖 ----
# 旧的本机依赖目录；可复现源码已迁移到 libs/。
/vendor/
/libs/chat-xdk/go/chatxdk/libs/

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example

# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Python(dev 脚本缓存) ----
__pycache__/
*.pyc

# ---- 日志 / 临时 ----
*.log
.agent-check/
.artifacts/
/dist/
# Claude Code agent worktrees
/.claude/worktrees/

# ---- 前端 tsc -b 构建产物(vite.config.ts 编译输出 + 增量信息) ----
*.tsbuildinfo
apps/web/vite.config.js
apps/web/vite.config.d.ts
