{
  "name": "onecrew-mcp-ui",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "contracts:check": "node ../development/schema-codegen/generate.mjs --config contracts.config.json --mode check",
    "contracts:generate": "node ../development/schema-codegen/generate.mjs --config contracts.config.json --mode generate",
    "test": "vitest run",
    "preview:build": "node preview/build.mjs",
    "preview:flows": "node preview/build-flows.mjs"
  },
  "dependencies": {
    "@onecrew/runtime-contracts": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-select": "5.10.2",
    "react-select-country-list": "2.2.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-select-country-list": "2.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
