{
  "name": "onecrew-lite-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": "26.7.0" },
  "scripts": {
    "onecrew_lite": "pnpm --filter onecrew_lite-app cli",
    "build:tables": "pnpm --filter onecrew_lite_tables build:teable && pnpm --filter onecrew_lite_tables build:server",
    "typecheck": "pnpm --filter onecrew_lite-app typecheck",
    "test:app": "pnpm --filter onecrew_lite-app test",
    "test:tables": "pnpm --filter onecrew_lite_tables test:embedded"
  }
}
