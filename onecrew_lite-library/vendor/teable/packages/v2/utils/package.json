{
  "name": "@teable/v2-utils",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch"
  },
  "dependencies": {
    "@teable/v2-core": "workspace:*",
    "ipaddr.js": "2.2.0",
    "request-filtering-agent": "3.2.0",
    "undici": "7.20.0"
  },
  "devDependencies": {
    "@teable/v2-tsdown-config": "workspace:*",
    "@types/node": "22.18.0",
    "@types/node-fetch": "2.6.11",
    "tsdown": "0.18.1",
    "typescript": "5.4.3"
  }
}
