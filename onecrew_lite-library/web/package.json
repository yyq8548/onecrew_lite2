    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "hono": "4.13.8",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
