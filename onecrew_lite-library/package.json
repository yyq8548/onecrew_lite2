{
  "name": "onecrew_lite_tables",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build:server && tsx watch --conditions=onecrew:source src/cli.ts serve --data-dir .data",
    "start": "node dist/cli.js start --data-dir .data",
    "build:web": "pnpm --dir web typecheck && pnpm --dir web build",
    "build:web:unified": "pnpm --dir web typecheck && pnpm --dir web build --mode unified",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "test": "tsx tests/integration/http-mcp.ts && pnpm test:rpc && pnpm test:tenancy && pnpm test:discovery-projection",
    "test:discovery-projection": "tsx tests/integration/discovery-projection-migration.ts && tsx tests/integration/discovery-identity-migration.ts && tsx tests/integration/discovery-identity-contract.ts && tsx tests/integration/discovery-field-protection.ts && tsx tests/integration/discovery-projection.ts && tsx tests/integration/discovery-ingest.ts && tsx tests/integration/discovery-sync-http.ts && tsx tests/integration/discovery-score-http.ts && tsx tests/integration/creator-updates.ts && tsx tests/integration/creator-refresh.ts",
    "test:browser": "tsx tests/integration/browser.ts",
    "test:embedded": "tsx tests/integration/embedded.ts",
    "test:discovery-sync": "tsx tests/integration/discovery-sync-http.ts && tsx tests/integration/discovery-score-http.ts",
    "test:search": "tsx tests/integration/search.ts",
    "test:stdio": "tsx tests/integration/mcp-stdio.ts",
    "test:port": "tsx tests/integration/port.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.{js,mjs,cjs}\" \"tests/**/*.{ts,mjs}\" \"web/**/*.{ts,tsx,css,json,html}\" \"browser-extension/**/*.{js,json,html,css}\" \"*.{js,json}\" \"packages/contracts/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.{js,mjs,cjs}\" \"tests/**/*.{ts,mjs}\" \"web/**/*.{ts,tsx,css,json,html}\" \"browser-extension/**/*.{js,json,html,css}\" \"*.{js,json}\" \"packages/contracts/**/*.{ts,json}\"",
    "typecheck": "pnpm build:server && tsc --noEmit && pnpm --dir web typecheck",
    "build:server": "tsc -b tsconfig.build.json",
    "build": "pnpm build:teable && pnpm build:server && pnpm build:web",
    "plugin:configure": "node dist/cli.js configure-plugin --plugin-dir plugins/onecrew-tables --data-dir .data",
    "test:distribution": "node tests/integration/distribution.mjs",
    "build:teable": "pnpm --filter \"@teable/*\" -r build",
    "stop": "node dist/cli.js stop --data-dir .data",
    "status": "node dist/cli.js status --data-dir .data",
    "restart": "node dist/cli.js restart --data-dir .data",
    "test:cli": "pnpm build:server && tsx tests/integration/cli.ts",
    "test:access": "tsx tests/integration/access.ts && tsx tests/integration/access-store.ts && tsx tests/integration/access-validation.ts && tsx tests/integration/access-navigation.mjs",
    "build:binary": "pnpm build && node scripts/build-binary.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:binary": "tsx tests/integration/binary.ts",
    "test:cli-help": "pnpm build:server && tsx tests/integration/cli-help.ts",
    "test:youtube": "tsx tests/integration/youtube-discovery.ts",
    "test:table-files": "tsx tests/integration/table-files.ts && tsx tests/integration/creator-export.ts",
    "test:database": "tsx tests/integration/database.ts",
    "test:rpc": "tsx tests/integration/rpc.ts && tsx tests/integration/web-client.ts",
    "test:tenancy": "tsx tests/integration/tenancy.ts",
    "build:contracts": "tsc -b packages/contracts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.7.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@teable/v2-adapter-csv-parser-papaparse": "workspace:*",
    "@teable/v2-adapter-db-postgres-shared": "workspace:*",
    "@teable/v2-adapter-repository-postgres": "workspace:*",
    "@teable/v2-adapter-table-repository-postgres": "workspace:*",
    "@teable/v2-core": "workspace:*",
    "@teable/v2-di": "workspace:*",
    "@teable/v2-import": "workspace:*",
    "@teable/v2-postgres-schema": "workspace:*",
    "fs-native-extensions": "1.5.0",
    "hono": "4.13.8",
    "kysely": "0.28.9",
    "kysely-pglite-dialect": "1.3.1",
    "p-limit": "^7.3.3",
    "systeminformation": "^5.33.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12",
    "@onecrew/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shadcn/lint": "^0.1.5",
    "@types/node": "^26.6.2",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "onecrew_lite_tables": "./dist/cli.js"
  },
  "exports": {
    "./migration-copy": {
      "types": "./dist/migration-copy.d.ts",
      "import": "./dist/migration-copy.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./rpc": {
      "types": "./dist/app.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  }
}
