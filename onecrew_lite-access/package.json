{
  "name": "reacher-access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "dev:worker": "NODE_OPTIONS=--dns-result-order=ipv4first wrangler dev --config wrangler.toml --port 8787 --local-upstream localhost:8787 --upstream-protocol http --var ACCESS_ORIGIN:http://localhost:8787 --var BETTER_AUTH_URL:http://localhost:8787 --var WEB_ORIGIN:http://localhost:8787",
    "dev:web": "node development/web.mjs dev access",
    "dev:site": "node development/web.mjs dev site",
    "types": "node development/generate-types.mjs",
    "typecheck:worker": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "typecheck:site": "tsc -p site/tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:worker && pnpm run typecheck:web && pnpm run typecheck:site",
    "test:worker": "vitest run --config vitest.config.mts",
    "test:operations": "node --test development/*.test.mjs",
    "test:web": "node development/web.mjs test",
    "test:site": "vitest run --config site/vitest.config.ts",
    "test": "pnpm run test:operations && pnpm run test:worker && pnpm run test:web && pnpm run test:site",
    "build:access": "node development/web.mjs build access",
    "build:site": "node development/web.mjs build site",
    "build:web": "node development/web.mjs build all && node development/check-web-build-boundaries.mjs",
    "build:worker": "wrangler deploy --config wrangler.toml --profile onecrew --dry-run --outdir dist/worker",
    "build:site-worker": "node development/check-site-csp.mjs && wrangler deploy --config site/wrangler.toml --profile onecrew --dry-run --outdir dist/site-worker",
    "build": "pnpm run build:web && pnpm run build:worker && pnpm run build:site-worker",
    "check:migrations": "node development/check-immutable-migrations.mjs",
    "check:domains": "node development/check-domain-boundary.mjs",
    "db:migrate:local": "node development/migrate.mjs --local",
    "db:migrate:remote": "node development/migrate.mjs --remote",
    "deploy": "node development/deploy.mjs",
    "deploy:site": "node development/deploy-site.mjs",
    "check": "pnpm run check:migrations && pnpm run check:domains && pnpm run types && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "accept-language-parser": "^1.5.0",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.5",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "5.2.2",
    "lucide-react": "0.545.0",
    "openid-client": "6.8.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "8.3.0",
    "resend": "^6.26.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jose": "6.2.12",
    "jsdom": "30.0.1",
    "parse5": "8.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
